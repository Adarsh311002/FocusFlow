# Copy to apps/api/.env for local development. No real secrets belong in this file.

# Application environment: development | test | production.
APP_ENV=development

# Interface the HTTP server binds to. Loopback keeps the dev API off the local
# network; set 0.0.0.0 only inside a container or on a server.
HOST=127.0.0.1

# Port the HTTP server listens on.
PORT=3000

# Log verbosity: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# PostgreSQL connection string; matches the local Docker credentials.
DATABASE_URL=postgres://focusflow:focusflow@127.0.0.1:5432/focusflow

# Redis connection string; matches the local Docker setup.
REDIS_URL=redis://127.0.0.1:6379

# Prefix for every Redis key this deployment owns (decision P3).
REDIS_KEY_PREFIX=ff:

# How long a graceful shutdown may take before the process is forced to exit.
SHUTDOWN_TIMEOUT_MS=10000

# Only used by `pnpm db:migrate`; falls back to DATABASE_URL if unset. In production
# this points at a role with DDL privileges, distinct from the app's own role.
# MIGRATION_DATABASE_URL=postgres://focusflow:focusflow@127.0.0.1:5432/focusflow

# Comma-separated "kid:secret" pairs signing/verifying access tokens (docs/architecture/auth.md).
# The FIRST pair is the active signing key; every pair is accepted for verification, so a
# new key can be added ahead of a rotation and the old one removed once it is unused.
# Each secret must be at least 32 characters. Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('hex'))"
# This example value is for local development only — never reuse it anywhere else.
JWT_ACCESS_SECRETS=dev1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Issuer/audience embedded in and checked against every access token. A stable name,
# not a URL; the same value works in every environment.
JWT_ISSUER=focus-flow
JWT_AUDIENCE=focus-flow

# Access token lifetime.
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token (cookie) lifetime.
REFRESH_TOKEN_TTL_SECONDS=2592000

# How long the immediately-previous refresh token is still accepted after rotation,
# so two tabs racing a refresh don't trigger reuse detection (docs/architecture/auth.md).
REFRESH_OVERLAP_SECONDS=20

# Real-time foundation (Phase 3, docs/architecture/redis-keys.md).
# Every process start is a new instance with a random id; set INSTANCE_ID only for tests.
# INSTANCE_ID=
# How often this instance publishes its heartbeat (scored by Redis TIME).
INSTANCE_HEARTBEAT_MS=10000
# An instance whose last heartbeat is older than this is dead. At least twice the heartbeat.
INSTANCE_TTL_MS=30000
