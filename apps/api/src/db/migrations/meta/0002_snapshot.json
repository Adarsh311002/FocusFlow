      "checkConstraints": {
        "ck_focus_sessions_status": {
          "name": "ck_focus_sessions_status",
          "value": "\"focus_sessions\".\"status\" IN ('in_progress', 'completed', 'abandoned')"
        },
        "ck_focus_sessions_abandon_reason": {
          "name": "ck_focus_sessions_abandon_reason",
          "value": "\"focus_sessions\".\"abandon_reason\" IN ('stopped', 'grace_expired', 'expired')"
        },
        "ck_focus_sessions_planned_seconds": {
          "name": "ck_focus_sessions_planned_seconds",
          "value": "\"focus_sessions\".\"planned_seconds\" BETWEEN 60 AND 14400"
        },
        "ck_focus_sessions_focused_seconds": {
          "name": "ck_focus_sessions_focused_seconds",
          "value": "\"focus_sessions\".\"focused_seconds\" BETWEEN 0 AND \"focus_sessions\".\"planned_seconds\""
        },
        "ck_focus_sessions_ended_at": {
          "name": "ck_focus_sessions_ended_at",
          "value": "(\"focus_sessions\".\"status\" = 'in_progress') = (\"focus_sessions\".\"ended_at\" IS NULL)"
        },
        "ck_focus_sessions_abandon_reason_presence": {
          "name": "ck_focus_sessions_abandon_reason_presence",
          "value": "(\"focus_sessions\".\"status\" = 'abandoned') = (\"focus_sessions\".\"abandon_reason\" IS NOT NULL)"
        },
        "ck_focus_sessions_running_since": {
          "name": "ck_focus_sessions_running_since",
          "value": "\"focus_sessions\".\"running_since\" IS NULL OR \"focus_sessions\".\"status\" = 'in_progress'"
        },
        "ck_focus_sessions_ended_after_started": {
          "name": "ck_focus_sessions_ended_after_started",
          "value": "\"focus_sessions\".\"ended_at\" IS NULL OR \"focus_sessions\".\"ended_at\" >= \"focus_sessions\".\"started_at\""
        },
        "ck_focus_sessions_running_since_after_started": {
          "name": "ck_focus_sessions_running_since_after_started",
          "value": "\"focus_sessions\".\"running_since\" IS NULL OR \"focus_sessions\".\"running_since\" >= \"focus_sessions\".\"started_at\""
        },
        "ck_focus_sessions_completed_focused": {
          "name": "ck_focus_sessions_completed_focused",
          "value": "\"focus_sessions\".\"status\" <> 'completed' OR \"focus_sessions\".\"focused_seconds\" = \"focus_sessions\".\"planned_seconds\""
        }
      },
