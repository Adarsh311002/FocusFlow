# Copy to services/ai/.env (git-ignored). Local development values only.

# mock: no key needed, nothing leaves your machine. anthropic: real answers from Claude.
AI_PROVIDER=mock
# Needed only with AI_PROVIDER=anthropic. Create a key in the Claude Console yourself.
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_REFUSAL_FALLBACK=true
# Must match AI_INTERNAL_TOKEN in apps/api/.env.
AI_INTERNAL_TOKEN=local-dev-internal-token-change-me
