# Docker Compose variables for infra/compose.yaml.
# Copy to infra/.env (git-ignored) and adjust only if a port is already in use.
#
# These are local-development credentials only. They are intentionally weak and
# must never be used for a deployed environment; the databases are published on
# 127.0.0.1 only, so they are not reachable from the network.
#
# The API composes its own connection strings from apps/api/.env, by default:
#   DATABASE_URL=postgres://focusflow:focusflow@127.0.0.1:5432/focusflow
#   REDIS_URL=redis://127.0.0.1:6379
# Keep the two files in sync when changing anything here.

# PostgreSQL superuser, password and initial database.
POSTGRES_USER=focusflow
POSTGRES_PASSWORD=focusflow
POSTGRES_DB=focusflow

# Host ports (bound to 127.0.0.1). Change only on a port conflict.
POSTGRES_PORT=5432
REDIS_PORT=6379
